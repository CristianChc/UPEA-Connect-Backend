// UPEA Connect API — Prisma Schema
// Stack: PostgreSQL · Prisma 7 (prisma-client generator)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FloatingElementType {
  TEXT
  IMAGE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatActionStatus {
  PENDING
  DONE
  DISCARDED
}

enum EventType {
  EXAM
  ASSIGNMENT
  CLASS
  REMINDER
  OTHER
}

model User {
  id            String              @id @default(cuid())
  nombre        String
  email         String              @unique
  password      String
  carrera       String
  semestre      String
  fotoUrl       String?
  emailVerified Boolean             @default(false)
  verification  EmailVerification?
  notes         Note[]
  events        Event[]
  conversations ChatConversation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model EmailVerification {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Note {
  id         String     @id @default(cuid())
  title      String
  content    String     @db.Text
  courseName String?
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages      NotePage[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([userId, courseName])
}

model NotePage {
  id               String             @id @default(cuid())
  pageIndex        Int
  textContent      String?
  noteId           String
  note             Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  floatingElements FloatingElement[]

  @@index([noteId])
}

model FloatingElement {
  id        String              @id @default(cuid())
  type      FloatingElementType
  positionX Float
  positionY Float
  width     Float
  height    Float
  text      String?
  imageUrl  String?
  pageId    String
  page      NotePage            @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  date        DateTime
  // --- Agregado para calzar con el calendario de Flutter (Anddy) ---
  endTime     String?   // formato "HH:mm", ej: "11:30"
  category    String?   // etiqueta libre que muestra la UI (ej: "Física")
  color       Int?      // color ARGB del evento en el calendario
  // -------------------------------------------------------------
  type        EventType @default(OTHER)
  isCompleted Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, date])
}

// --- Historial del chat con IA ---
model ChatConversation {
  id        String        @id @default(cuid())
  title     String        @default("Nueva conversación")
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  role           ChatRole
  text           String            @db.Text
  // Acción propuesta por la IA ({ type, data }) cuando role = ASSISTANT
  action         Json?
  // Estado de la tarjeta de acción: null si el mensaje no tiene acción
  actionStatus   ChatActionStatus?
  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}
