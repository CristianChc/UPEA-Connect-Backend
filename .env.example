# ===== UPEA Connect API — Plantilla de variables de entorno =====
# Copia este archivo a .env y completa los valores.

# --- Base de datos ---
# LOCAL (Docker, como viene el devcontainer):
DATABASE_URL="postgresql://upea:upea_dev_pass@localhost:5432/upea_connect"
DIRECT_URL="postgresql://upea:upea_dev_pass@localhost:5432/upea_connect"

# PRODUCCION (Neon serverless):
#   Entra a https://console.neon.tech -> tu proyecto -> Connect.
#   - DATABASE_URL es la conexion POOLED (recomendada para serverless).
#   - DIRECT_URL es la conexion DIRECTA (obligatoria para prisma migrate).
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/upea_connect?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/upea_connect?sslmode=require"

# --- JWT ---
# Generalo con: openssl rand -base64 32
JWT_SECRET="cambia-este-secreto"
JWT_EXPIRES_IN="7d"

# --- CORS ---
# Dominio del frontend Flutter. "*" solo para desarrollo.
CORS_ORIGIN="*"
